# Runtime
NODE_ENV=development
PORT=3000

# Database - obrigatório. Não commitar credenciais reais.
DATABASE_URL=postgresql://user:password@localhost:5432/finance_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Auth - obrigatório. Gere com: openssl rand -hex 64
JWT_SECRET=replace_with_a_64_byte_random_secret
JWT_EXPIRES_IN=1d

# CORS - use vírgula para múltiplas origens
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Frontend public API URL. Pode ficar exposto no bundle.
VITE_API_URL=http://localhost:3000

# Rate limit
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=10

# Pluggy / Open Finance - SOMENTE BACKEND. Nunca prefixar com VITE_.
PLUGGY_CLIENT_ID=replace_with_pluggy_client_id
PLUGGY_CLIENT_SECRET=replace_with_pluggy_client_secret
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_TIMEOUT_MS=15000

# Webhook Open Finance
PLUGGY_WEBHOOK_SECRET=replace_with_shared_webhook_secret
PLUGGY_WEBHOOK_MAX_AGE_SECONDS=300
